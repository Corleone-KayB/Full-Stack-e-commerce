# ===========================================================================
# AURUM — environment configuration
#
# Copy to `.env` and fill in. NOTHING in this file is ever imported into
# client code: every value here is read exclusively in server modules.
# The only variables that may be exposed to the browser are those prefixed
# NEXT_PUBLIC_ (there are two, both non-secret).
# ===========================================================================

# ---------------------------------------------------------------------------
# CORE
# ---------------------------------------------------------------------------
# The driver is chosen from the URL shape — see src/lib/db-adapter.ts.
#
# Local dev (zero setup, SQLite via libSQL):
DATABASE_URL="file:./dev.db"
#
# Hosted libSQL / Turso — keep provider = "sqlite" in prisma/schema.prisma:
# DATABASE_URL="libsql://your-database.turso.io"
# DATABASE_AUTH_TOKEN=""
#
# Production (PostgreSQL) — also change `provider` in prisma/schema.prisma:
# DATABASE_URL="postgresql://user:password@host:5432/aurum?schema=public&sslmode=require"
# DATABASE_POOL_MAX="10"
#
# Note: if your network blocks binaries.prisma.sh, the APPLICATION is unaffected
# (Prisma 7 uses driver adapters and ships no query engine). Only the Prisma CLI
# needs a schema engine, and only for `migrate`/`db push` — run those from a
# machine that can reach it, or set PRISMA_SCHEMA_ENGINE_BINARY to a local copy.

# Public origin, used for absolute URLs, SEO canonicals and payment callbacks.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# 32+ random bytes. Generate: openssl rand -base64 48
# Signs session cookies and the CSRF double-submit token.
AUTH_SECRET="change-me-openssl-rand-base64-48"
SESSION_TTL_DAYS="30"

# Seed credentials for the first super admin (used by `npm run db:seed`).
SEED_ADMIN_EMAIL="admin@aurum.store"
SEED_ADMIN_PASSWORD="ChangeMe!2026"

# ---------------------------------------------------------------------------
# PAYMENTS — GLOBAL
# ---------------------------------------------------------------------------
# "sandbox" or "live". Sandbox and live credentials must NEVER be mixed;
# the payment registry refuses to start a live payment with sandbox keys.
PAYMENTS_ENVIRONMENT="sandbox"
# Comma-separated provider ids to enable: mtn_momo,airtel_money,card,simulator
PAYMENTS_ENABLED="simulator,mtn_momo,airtel_money,card"
# Minutes before an unpaid, unconfirmed payment expires and stock is released.
PAYMENT_EXPIRY_MINUTES="15"

# ---------------------------------------------------------------------------
# MTN MOBILE MONEY (Collections API)
# Merchant: create a subscription at https://momodeveloper.mtn.com, subscribe
# to the "Collections" product, then generate an API user + API key.
# Verify every endpoint against the official docs before going live.
# ---------------------------------------------------------------------------
MTN_BASE_URL="https://sandbox.momodeveloper.mtn.com"
MTN_SUBSCRIPTION_KEY=""          # Ocp-Apim-Subscription-Key (Collections)
MTN_API_USER=""                  # API user UUID
MTN_API_KEY=""                   # API key generated for that user
MTN_TARGET_ENVIRONMENT="sandbox" # sandbox | mtnrwanda | mtnuganda | ...
MTN_CURRENCY="EUR"               # sandbox only accepts EUR; live uses e.g. RWF
MTN_CALLBACK_HOST="localhost:3000"
MTN_WEBHOOK_SECRET=""            # shared secret for callback HMAC, if provisioned

# ---------------------------------------------------------------------------
# AIRTEL MONEY (Collections API)
# Merchant: register at https://developers.airtel.africa, create an app, and
# obtain client credentials. Production requires an RSA public key for
# PIN/payload encryption — supply it below in base64 DER/PEM form.
# ---------------------------------------------------------------------------
AIRTEL_BASE_URL="https://openapiuat.airtel.africa"
AIRTEL_CLIENT_ID=""
AIRTEL_CLIENT_SECRET=""
AIRTEL_COUNTRY="RW"
AIRTEL_CURRENCY="RWF"
AIRTEL_PUBLIC_KEY=""             # base64 RSA public key for payload encryption
AIRTEL_WEBHOOK_SECRET=""         # shared secret used to sign callbacks

# ---------------------------------------------------------------------------
# CARD PROCESSOR (hosted checkout / tokenised — no PAN ever touches us)
# The adapter is written against a Stripe-compatible hosted-session API.
# Point it at your processor and supply the keys below.
# ---------------------------------------------------------------------------
CARD_PROVIDER="stripe"           # stripe | mock
CARD_API_BASE="https://api.stripe.com"
CARD_PROCESSOR_SECRET=""         # secret key — server only, never NEXT_PUBLIC
CARD_WEBHOOK_SECRET=""           # signing secret for webhook verification
CARD_CURRENCY="AED"

# ---------------------------------------------------------------------------
# OBJECT STORAGE (product imagery)
# Local dev writes to /public/uploads. In production use S3/R2/Blob.
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"           # local | s3
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# ---------------------------------------------------------------------------
# NOTIFICATIONS
# ---------------------------------------------------------------------------
MAIL_DRIVER="log"                # log | smtp
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="AURUM <orders@aurum.store>"
SMS_DRIVER="log"                 # log | http
SMS_API_URL=""
SMS_API_KEY=""

# ---------------------------------------------------------------------------
# OPERATIONS
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED="true"
LOG_LEVEL="info"                 # debug | info | warn | error
# Optional analytics tag — left blank, nothing is loaded.
NEXT_PUBLIC_ANALYTICS_ID=""
